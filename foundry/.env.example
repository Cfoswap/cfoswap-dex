# ============================================================
# Cfoswap 部署配置文件 (.env)
# 复制本文件为 .env 并填入真实值
# 所有地址请去掉 0x 以外的空格和引号
# ============================================================

# ---- 必填：链 & 钱包 ----
PRIVATE_KEY=你的私钥（去掉0x前缀也可以，保留也行）
RPC_URL=https://bsc-dataseed.binance.org/
CHAIN_ID=56

# BscScan API Key (用于 forge create --verify 自动开源验证)
# 到 https://bscscan.com/myapikey 免费申请，填入你自己的 Key
BSCSCAN_API_KEY=你的BscScan_API_Key

# ---- 可选：Gnosis Safe 多签地址（填写后，部署完成会自动把 4 个业务合约的 owner 转移到 Safe）
# 留空 = 跳过所有权转移（owner 保持为部署私钥的地址）
SAFE_ADDRESS=

# ---- Router Owner（默认用部署者地址，留空即可）
ROUTER_OWNER=

# === CfoSwapToken 交易税分发：3 地址 + 比例（和必须=100%）===
# 收税钱包地址 ①（默认填 40%）
TAX_WALLET_1=
# 收税钱包地址 ②（默认填 30%）
TAX_WALLET_2=
# 收税钱包地址 ③（默认填 30%）
TAX_WALLET_3=
# 比例（百分比，不用转基点，脚本自动处理）
TAX_SHARE_1_PCT=40
TAX_SHARE_2_PCT=30
TAX_SHARE_3_PCT=30

# === CfoMiningPool 助力费接收地址 ===
# 留空默认使用部署者地址
BOOST_FEE_RECIPIENT=

# === CfoswapRouter 平台手续费分发：3 地址 + 比例（和必须=100%）===
PLATFORM_WALLET_1=
PLATFORM_WALLET_2=
PLATFORM_WALLET_3=
PLATFORM_SHARE_1_PCT=40
PLATFORM_SHARE_2_PCT=30
PLATFORM_SHARE_3_PCT=30

# === CfoSwapMining 主矿池解锁时长（按「天」填，默认 365 天，脚本自动 ×86400 转秒）===
VESTING_DAYS=365
